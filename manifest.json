{
  "manifest_version": 3,
  "name": "Flight Deck",
  "version": "1.4.2",
  "description": "Quick natural-language and voice flight lookups on Delta, United, and American — Google Flights data via SerpApi, parsed and summarized by Claude, voice by OpenAI.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://serpapi.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Flight Deck"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
